# ── OCI Object Storage (para el modelo .pkl) ──
OCI_OS_NAMESPACE=tu-namespace-aqui
OCI_OS_BUCKET=vinnah-models
OCI_OS_REGION=sa-saopaulo-1

# ── Spring Boot (backend) ──
JWT_SECRET=clave-secreta-min-32-caracteres-cambiar-en-produccion
OCI_DB_HOST=localhost
OCI_DB_SERVICE=XEPDB1
OCI_DB_USER=app_user
OCI_DB_PASSWORD=changeme

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── Notas ──
# Las credenciales de OCI se configuran en ~/.oci/config (nunca en el repo)
# Para desarrollo local usar perfil dev: ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
